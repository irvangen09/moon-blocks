<?xml version="1.0"?>
<ruleset name="Moon Blocks">
	<description>Coding standard ruleset for the Moon Blocks plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra">
		<!-- Class files use PSR-4 names (includes/Core/Plugin.php), not class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="moon-blocks"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="moon_blocks"/>
				<element value="MoonBlocks"/>
				<element value="MOON_BLOCKS"/>
			</property>
		</properties>
		<!-- WordPress includes render.php from inside a method, so its variables are not global. -->
		<exclude-pattern>*/render.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/render.php</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="6.9"/>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.0-"/>
</ruleset>